# One site, one origin: the built front end and the API share a host, so
# the browser never makes a cross-origin request and CORS never comes up.
#
# Naming the site by domain is what turns on automatic HTTPS: Caddy obtains
# a Let's Encrypt certificate on first start, renews it on its own, and
# redirects plain HTTP to HTTPS. Port 80 must stay open for that — the
# certificate authority checks the domain over it.

{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		# Planning takes five to eight seconds; Caddy sets no response
		# timeout by default, so none is needed here.
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# The app has no client-side routes, but an unknown path should
		# still land on the app rather than on a bare 404.
		try_files {path} /index.html
		file_server
	}

	# Vite fingerprints everything under /assets, so those files can be
	# cached for good; index.html must not be, or a deploy would leave
	# browsers asking for bundles that no longer exist.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@shell path / /index.html
	header @shell Cache-Control "no-cache"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
