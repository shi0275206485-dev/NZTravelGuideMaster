# Copy to deploy/.env on the server and fill in. deploy/.env is ignored by
# git; this file is the only one that should be committed.

# --- Site ---
# The DuckDNS name pointing at the instance's Elastic IP.
DOMAIN=yourname.duckdns.org

# --- LLM ---
# Your Model Studio key and the workspace endpoint it belongs to. The
# endpoint is account-specific — copy it from the console, not from here.
LLM_API_KEY=
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-flash

# --- Access control ---
# Required for a public deployment. Long enough not to be guessed within
# the attempt limit below: four random words, say, rather than a PIN.
DEMO_ACCESS_CODE=

# --- Usage limits (see backend/app/quota.py) ---
RATE_LIMIT_GENERATE=3/hour
DAILY_GENERATION_CAP=30
ACCESS_CODE_ATTEMPTS=10/hour
